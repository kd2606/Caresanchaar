[debug] [2026-09-06T12:32:15.505Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/healthsense-ai-prod-478/rulesets {"name":"projects/healthsense-ai-prod-478/rulesets/44c9726d-e08f-45bc-b0c4-3d9f0f9ecd39","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    // Core Functions\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n    \n    function getRole() {\n      // Expecting role to be set in token: 'patient', 'asha', 'mo', 'district_admin'\n      return request.auth.token.role;\n    }\n    \n    function isOwner(uid) {\n      return request.auth.uid == uid;\n    }\n    \n    function isTestDataFiltered() {\n      // Enforce that queries on real data exclude test data unless explicitly queried by tester\n      return !('isTestData' in request.resource.data) || request.resource.data.isTestData == false;\n    }\n\n    function isWorker() {\n      return getRole() == 'asha' || getRole() == 'worker';\n    }\n\n    match /users/{userId} {\n      allow read, write: if isAuthenticated() && isOwner(userId);\n      \n      match /{document=**} {\n        allow read, write: if isAuthenticated() && isOwner(userId);\n      }\n    }\n    \n    match /user_roles/{userId} {\n      allow read: if isAuthenticated() && isOwner(userId);\n      allow write: if false; \n    }\n\n    match /patients/{patientId} {\n      // Patients read their own\n      allow read: if isAuthenticated() && getRole() == 'patient' && isOwner(patientId);\n      // Worker reads assigned (where owner_uid == worker uid)\n      allow read, create: if isAuthenticated() && isWorker() && request.resource.data.owner_uid == request.auth.uid;\n      allow update: if isAuthenticated() && isWorker() && resource.data.owner_uid == request.auth.uid && request.resource.data.owner_uid == request.auth.uid;\n      allow delete: if false;\n    }\n\n    match /triage_records/{recordId} {\n      allow read: if isAuthenticated() && ((getRole() == 'patient' && resource.data.patient_id == request.auth.uid) || (isWorker() && resource.data.owner_uid == request.auth.uid));\n      allow create: if isAuthenticated() && isWorker() && request.resource.data.owner_uid == request.auth.uid;\n      allow update, delete: if false; // clinical records are write-once\n    }\n\n    match /referrals/{referralId} {\n      allow read: if isAuthenticated() && isWorker() && resource.data.owner_uid == request.auth.uid;\n      // Medical Officer can read referrals routed to their facility\n      allow read: if isAuthenticated() && getRole() == 'mo' && resource.data.target_facility == request.auth.token.facility_id;\n      // Creation is allowed by Worker only via proposals to 'CREATED' state\n      allow create: if isAuthenticated() && isWorker() && request.resource.data.owner_uid == request.auth.uid && request.resource.data.status == 'CREATED';\n      // Updates strictly handled by server functions\n      allow update: if false;\n      allow delete: if false;\n    }\n\n    match /worker_tasks/{taskId} {\n      allow read: if isAuthenticated() && isWorker() && resource.data.worker_uid == request.auth.uid;\n      allow create: if isAuthenticated() && isWorker() && request.resource.data.worker_uid == request.auth.uid;\n      allow update: if isAuthenticated() && isWorker() && resource.data.worker_uid == request.auth.uid;\n      allow delete: if false;\n    }\n\n    match /referral_events/{eventId} {\n      allow read: if isAuthenticated() && (isWorker() || getRole() == 'mo');\n      allow write: if false; // Server authoritative\n    }\n\n    match /audit_events/{eventId} {\n      allow read: if isAuthenticated() && getRole() == 'compliance_auditor';\n      allow write: if false; // Server written only\n    }\n\n    match /aggregates/{docId} {\n      allow read: if isAuthenticated() && getRole() == 'district_admin';\n      allow write: if false; // Server computed\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-06T12:32:16.935727Z","metadata":{"services":["cloud.firestore"]}}
